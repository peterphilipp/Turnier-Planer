generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tournament {
  id                     Int                    @id @default(autoincrement()) @map("id")
  name                   String
  description            String?                @map("description")
  startDate              DateTime               @map("start_date")
  endDate                DateTime               @map("end_date")
  status                 String                 @default("aktiv") @map("status")
  turnierModus           String                 @default("GRUPPEN_KO") @map("turnier_modus")
  teamsAdvancingPerGroup Int                    @default(2) @map("teams_advancing_per_group")
  playoutAllPlacements   Boolean                @default(false) @map("playout_all_placements")
  thirdPlaceMatch        Boolean                @default(true) @map("third_place_match")
  qualificationRule      String?                @map("qualification_rule")
  createdAt              DateTime               @default(now()) @map("created_at")
  clubId                 Int?                   @map("club_id")
  logo                   String?
  hasSponsor             Boolean                @default(false) @map("has_sponsor")
  sponsorName            String?                @map("sponsor_name")
  sponsorUrl             String?                @map("sponsor_url")
  estimatedVisitors      Int?                   @map("estimated_visitors")
  teamCount              Int?                   @map("team_count")
  fields                 Field[]
  foodDonationSlots      FoodDonationSlot[]
  shoppingListItems      ShoppingListItem[]
  donations              FoodDonation[]
  groups                 Group[]
  brackets               KnockoutBracket[]
  matches                Match[]
  materials              MaterialItem[]
  shifts                 Shift[]
  tournamentDays         TournamentDay[]
  tournamentWorkAreas    TournamentWorkArea[]
  standings              StandingsEntry[]
  timeSlots              TimeSlot[]
  tournamentClubs        TournamentClub[]
  users                  User[]
  club                   Club?                  @relation(fields: [clubId], references: [id])
  volunteerShifts        VolunteerShift[]
  yearGroups             YearGroup[]            @relation("TournamentYearGroups")
  teams                  Team[]
  memberships            TournamentMembership[]

  @@map("tournaments")
}

// Explizite "dieser Helfer ist für dieses Turnier relevant/aktiv"-Relation -
// getrennt von User.tournamentId (das ist nur "zuletzt angesehen/Präferenz",
// ein einzelner Wert) und von VolunteerShift (das ist die tatsächliche
// Schicht-Zuweisung, kein genereller Turnier-Bezug). Wird automatisch beim
// Registrieren, Schicht-Zusagen, Verpflegungs-Spenden erzeugt (kein manuelles
// Pflegen nötig) und ist die Quelle für: (a) welche abgeschlossenen Turniere
// ein Helfer im Self-Service sehen darf, (b) Push-Zielgruppen pro Turnier.
model TournamentMembership {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  tournamentId Int        @map("tournament_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@map("tournament_memberships")
}

model Club {
  id              Int              @id @default(autoincrement())
  name            String
  logo            String?          @map("logo")
  primaryColor    String           @default("#0d6efd") @map("primary_color")
  secondaryColor  String           @default("#6c757d") @map("secondary_color")
  accentColor     String           @default("#198754") @map("accent_color")
  city            String?          @map("city")
  teams           Team[]
  tournamentClubs TournamentClub[]
  tournaments     Tournament[]

  @@map("clubs")
}

model Group {
  id           Int        @id @default(autoincrement())
  name         String
  order        Int        @default(0)
  tournamentId Int        @map("tournament_id")
  yearGroupId  Int?       @map("year_group_id")
  yearGroup    YearGroup? @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@index([tournamentId])
  @@index([yearGroupId])
  @@map("groups")
}

model Team {
  id             Int             @id @default(autoincrement())
  name           String
  groupId        Int?            @map("group_id")
  tournamentId   Int?            @map("tournament_id")
  yearGroupId    Int?            @map("year_group_id")
  clubId         Int?            @map("club_id")
  goalsFor       Int             @default(0) @map("goals_for")
  goalsAgainst   Int             @default(0) @map("goals_against")
  bracketTyp     String?         @map("bracket_typ")
  matchesAsB     Match[]         @relation("teamBMatches")
  matchesAsA     Match[]         @relation("teamAMatches")
  standingsEntry StandingsEntry? @relation("teamStandings")
  yearGroup      YearGroup?      @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  group          Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tournament     Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  club           Club?           @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([groupId])
  @@index([yearGroupId])
  @@index([clubId])
  @@map("teams")
}

model Match {
  id           Int              @id @default(autoincrement())
  tournamentId Int              @map("tournament_id")
  yearGroupId  Int?             @map("year_group_id")
  bracketId    Int?             @map("bracket_id")
  timeSlotId   Int?             @map("time_slot_id")
  fieldId      Int?             @map("field_id")
  teamAId      Int?             @map("team_a_id")
  teamBId      Int?             @map("team_b_id")
  placeholderA String?          @map("placeholder_a")
  placeholderB String?          @map("placeholder_b")
  scoreA       Int?             @map("score_a")
  scoreB       Int?             @map("score_b")
  phase        String           @default("Gruppenphase") @map("phase")
  runde        String?          @map("runde")
  bracketTyp   String?          @map("bracket_typ")
  siegerId     Int?             @map("sieger_id")
  verliererId  Int?             @map("verlierer_id")
  status       String           @default("geplant") @map("status")
  time         DateTime
  lowerBound   Int?             @map("lower_bound")
  stage        Int?             @map("stage")
  upperBound   Int?             @map("upper_bound")
  yearGroup    YearGroup?       @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  teamB        Team?            @relation("teamBMatches", fields: [teamBId], references: [id], onDelete: Cascade)
  teamA        Team?            @relation("teamAMatches", fields: [teamAId], references: [id], onDelete: Cascade)
  field        Field?           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  timeSlot     TimeSlot?        @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracket      KnockoutBracket? @relation("KnockoutMatches", fields: [bracketId], references: [id])

  @@index([tournamentId])
  @@index([yearGroupId])
  @@index([bracketId])
  @@index([teamAId])
  @@index([teamBId])
  @@index([fieldId])
  @@index([timeSlotId])
  @@map("matches")
}

model User {
  id                    Int                    @id @default(autoincrement())
  name                  String
  email                 String?                @map("email")
  phone                 String?                @map("phone")
  password              String?                @map("password")
  role                  String                 @default("HELPER")
  tournamentId          Int?                   @map("tournament_id")
  consentGiven          Boolean                @default(false) @map("consent_given")
  consentDate           DateTime?              @map("consent_date")
  recoveryPin           String?                @map("recovery_pin")
  foodDonationSlots     FoodDonationSlot[]
  foodDonations         FoodDonation[]
  resetTokens           PasswordResetToken[]
  children              UserChild[]
  shifts                VolunteerShift[]
  pushSubscriptions     PushSubscription[]
  webAuthnCredentials   WebAuthnCredential[]
  tournament            Tournament?            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentMemberships TournamentMembership[]

  @@index([tournamentId])
  @@map("users")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Ein registrierter Passkey (Face ID/Touch ID/Android-Fingerabdruck/Security
// Key) pro Gerät. credentialId ist der eindeutige, öffentliche Bezeichner des
// Credentials (base64url) - publicKey/counter werden für jede Anmeldung zur
// kryptografischen Verifikation gebraucht (siehe passkey.routes.ts). Ein User
// kann mehrere Passkeys haben (mehrere Geräte).
model WebAuthnCredential {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      Int      @default(0)
  transports   String?  @map("transports")
  deviceType   String?  @map("device_type")
  backedUp     Boolean  @default(false) @map("backed_up")
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model UserChild {
  id        Int    @id @default(autoincrement())
  userId    Int?   @map("user_id")
  childName String @map("child_name")
  childYear Int    @map("child_year")
  user      User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("volunteer_children")
}

model VolunteerShift {
  id                 Int         @id @default(autoincrement())
  userId             Int?        @map("user_id")
  tournamentId       Int?        @map("tournament_id")
  shiftId            Int?        @map("shift_id")
  date               DateTime
  slot               String
  role               String
  areaId             String?     @map("area_id")
  ratingWorkload     Int?        @map("rating_workload")
  ratingOrganization Int?        @map("rating_organization")
  ratingFun          Int?        @map("rating_fun")
  ratingComment      String?     @map("rating_comment")
  reminderSentBefore Boolean     @default(false) @map("reminder_sent_before")
  thanksSentAfter    Boolean     @default(false) @map("thanks_sent_after")
  shift              Shift?      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user               User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament         Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tournamentId])
  @@index([shiftId])
  @@map("volunteer_shifts")
}

model WorkArea {
  id                Int                     @id @default(autoincrement())
  name              String
  icon              String                  @default("📍")
  order             Int                     @default(0)
  minVolunteers     Int                     @default(2) @map("min_volunteers")
  maxVolunteers     Int                     @default(8) @map("max_volunteers")
  color             String                  @default("#3b98f8")
  operatingStartMin Int?                    @map("operating_start_min")
  operatingEndMin   Int?                    @map("operating_end_min")
  isObsolete        Boolean                 @default(false) @map("is_obsolete")
  catalogSlots      GlobalDaySlotWorkArea[]
  categories        WorkAreaCategory[]      @relation("WorkAreaToCategories")

  @@map("arbeitsbereiche")
}

// ---------- Tag-Vorlagen-Katalog (global, Stammdaten) ----------
model GlobalDayTemplate {
  id         Int             @id @default(autoincrement())
  name       String
  isObsolete Boolean         @default(false) @map("is_obsolete")
  createdAt  DateTime        @default(now()) @map("created_at")
  slots      GlobalDaySlot[]

  @@map("global_day_templates")
}

model WorkAreaCategory {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  order      Int        @default(0)
  color      String     @default("#e7f1ff")
  isObsolete Boolean    @default(false) @map("is_obsolete")
  createdAt  DateTime   @default(now()) @map("created_at")
  workAreas  WorkArea[] @relation("WorkAreaToCategories")

  @@map("work_area_categories")
}

model GlobalDaySlot {
  id         Int                     @id @default(autoincrement())
  templateId Int                     @map("template_id")
  startMin   Int                     @map("start_min")
  endMin     Int                     @map("end_min")
  label      String?
  color      String                  @default("#3b98f8")
  order      Int                     @default(0)
  template   GlobalDayTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  workAreas  GlobalDaySlotWorkArea[]

  @@index([templateId])
  @@map("global_day_slots")
}

model GlobalDaySlotWorkArea {
  id           Int           @id @default(autoincrement())
  globalSlotId Int           @map("global_slot_id")
  workAreaId   Int           @map("work_area_id")
  order        Int           @default(0)
  slot         GlobalDaySlot @relation(fields: [globalSlotId], references: [id], onDelete: Cascade)
  workArea     WorkArea      @relation(fields: [workAreaId], references: [id], onDelete: Cascade)

  @@unique([globalSlotId, workAreaId])
  @@index([workAreaId])
  @@map("global_day_slot_work_areas")
}

// ---------- Turnier-Instanzen (Snapshot pro Turnier) ----------
model TournamentWorkArea {
  id                Int        @id @default(autoincrement())
  tournamentId      Int        @map("tournament_id")
  sourceWorkAreaId  Int?       @map("source_work_area_id")
  name              String
  icon              String     @default("📍")
  order             Int        @default(0)
  color             String     @default("#3b98f8")
  minVolunteers     Int        @default(2) @map("min_volunteers")
  maxVolunteers     Int        @default(8) @map("max_volunteers")
  operatingStartMin Int?       @map("operating_start_min")
  operatingEndMin   Int?       @map("operating_end_min")
  active            Boolean    @default(true)
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  shifts            Shift[]

  @@index([tournamentId])
  @@map("tournament_work_areas")
}

model TournamentDay {
  id               Int        @id @default(autoincrement())
  tournamentId     Int        @map("tournament_id")
  date             DateTime
  order            Int        @default(0)
  label            String?
  sourceTemplateId Int?       @map("source_template_id")
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  slots            DaySlot[]
  shifts           Shift[]

  @@unique([tournamentId, date])
  @@index([tournamentId])
  @@map("tournament_days")
}

model DaySlot {
  id                 Int           @id @default(autoincrement())
  tournamentDayId    Int           @map("tournament_day_id")
  startMin           Int           @map("start_min")
  endMin             Int           @map("end_min")
  label              String?
  color              String        @default("#3b98f8")
  order              Int           @default(0)
  sourceGlobalSlotId Int?          @map("source_global_slot_id")
  day                TournamentDay @relation(fields: [tournamentDayId], references: [id], onDelete: Cascade)
  shifts             Shift[]

  @@index([tournamentDayId])
  @@map("day_slots")
}

model Shift {
  id                   Int                @id @default(autoincrement())
  tournamentId         Int                @map("tournament_id")
  tournamentDayId      Int                @map("tournament_day_id")
  daySlotId            Int                @map("day_slot_id")
  tournamentWorkAreaId Int                @map("tournament_work_area_id")
  startMin             Int?               @map("start_min")
  endMin               Int?               @map("end_min")
  minVolunteers        Int                @default(2) @map("min_volunteers")
  maxVolunteers        Int                @default(8) @map("max_volunteers")
  description          String?            @map("description")
  tournament           Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  day                  TournamentDay      @relation(fields: [tournamentDayId], references: [id], onDelete: Cascade)
  daySlot              DaySlot            @relation(fields: [daySlotId], references: [id], onDelete: Cascade)
  workArea             TournamentWorkArea @relation(fields: [tournamentWorkAreaId], references: [id], onDelete: Cascade)
  volunteerShifts      VolunteerShift[]

  @@index([tournamentId])
  @@index([tournamentDayId])
  @@index([daySlotId])
  @@index([tournamentWorkAreaId])
  @@map("shifts")
}

model MaterialItem {
  id           Int        @id @default(autoincrement())
  tournamentId Int        @map("tournament_id")
  name         String
  quantity     Int        @default(1)
  unit         String     @default("Stk")
  done         Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("material_items")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  token     String   @unique @map("token")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false) @map("used")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model FoodCategory {
  id        Int        @id @default(autoincrement())
  name      String
  icon      String     @default("🍽️")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  items     FoodItem[]

  @@map("food_categories")
}

model FoodItem {
  id                Int                @id @default(autoincrement())
  categoryId        Int                @map("category_id")
  name              String
  price             String?            @map("price")
  unit              String             @default("Stk")
  createdAt         DateTime           @default(now())
  foodDonationSlots FoodDonationSlot[]
  donations         FoodDonation[]
  category          FoodCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("food_items")
}

model FoodDonation {
  id                 Int               @id @default(autoincrement())
  tournamentId       Int               @map("tournament_id")
  userId             Int?              @map("user_id")
  foodDonationSlotId Int?              @map("food_donation_slot_id")
  foodItemId         Int               @map("food_item_id")
  quantity           Int
  note               String?
  createdAt          DateTime          @default(now())
  foodDonationSlot   FoodDonationSlot? @relation(fields: [foodDonationSlotId], references: [id], onDelete: Cascade)
  foodItem           FoodItem          @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament         Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([userId])
  @@index([foodDonationSlotId])
  @@index([foodItemId])
  @@map("food_donations")
}

model YearGroup {
  id                Int                @id @default(autoincrement())
  name              String             @map("name")
  birthYearStart    Int                @map("birth_year_start")
  birthYearEnd      Int                @map("birth_year_end")
  order             Int                @default(0)
  isActive          Boolean            @default(true) @map("is_active")
  fields            Field[]
  foodDonationSlots FoodDonationSlot[]
  groups            Group[]
  brackets          KnockoutBracket[]
  matches           Match[]
  teams             Team[]
  timeSlots         TimeSlot[]
  tournaments       Tournament[]       @relation("TournamentYearGroups")

  @@map("year_groups")
}

model FoodDonationSlot {
  id             Int            @id @default(autoincrement())
  tournamentId   Int            @map("tournament_id")
  yearGroupId    Int?           @map("year_group_id")
  foodItemId     Int?           @map("food_item_id")
  targetQuantity Int            @default(0) @map("target_quantity")
  collected      Int            @default(0) @map("collected")
  description    String?        @map("description")
  createdAt      DateTime       @default(now()) @map("created_at")
  userId         Int?           @map("user_id")
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem       FoodItem?      @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  tournament     Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  yearGroup      YearGroup?     @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  donations      FoodDonation[]

  @@unique([tournamentId, yearGroupId, foodItemId])
  @@index([userId])
  @@index([yearGroupId])
  @@index([foodItemId])
  @@map("food_donation_slots")
}

// Wiederverwendbarer Artikel-Katalog für Einkaufslisten (Food UND Non-Food -
// z.B. auch Kohle, Becher, Reinigungsmittel), getrennt vom FoodItem-Katalog
// (der ist Spenden-/Verpflegungs-spezifisch mit eigener, food-typischer
// Einheiten-Logik). Ein Artikel wird einmal angelegt (manuell oder per
// Barcode-Scan aus Open Food Facts übernommen) und ist danach turnier-
// übergreifend wiederverwendbar - das ist die Grundlage fürs "aus Turnieren
// lernen": eine Einkaufsliste eines neuen Turniers kann die Katalog-Artikel
// eines vorherigen Turniers übernehmen (siehe copyShoppingList).
model ShoppingCatalogItem {
  id        Int                @id @default(autoincrement())
  name      String
  category  String?
  unit      String             @default("Stk")
  barcode   String?            @unique
  createdAt DateTime           @default(now()) @map("created_at")
  listItems ShoppingListItem[]

  @@index([barcode])
  @@map("shopping_catalog_items")
}

// Eine Zeile der Einkaufsliste eines konkreten Turniers: geplante Menge
// (Soll) vs. tatsächlich besorgt (Ist) - gleiches Soll/Ist-Muster wie bei
// FoodDonationSlot oben.
model ShoppingListItem {
  id                Int                 @id @default(autoincrement())
  tournamentId      Int                 @map("tournament_id")
  catalogItemId     Int                 @map("catalog_item_id")
  plannedQuantity   Int                 @default(0) @map("planned_quantity")
  purchasedQuantity Int                 @default(0) @map("purchased_quantity")
  note              String?
  createdAt         DateTime            @default(now()) @map("created_at")
  tournament        Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  catalogItem       ShoppingCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, catalogItemId])
  @@index([tournamentId])
  @@index([catalogItemId])
  @@map("shopping_list_items")
}

model TimeSlot {
  id           Int        @id @default(autoincrement())
  tournamentId Int        @map("tournament_id")
  yearGroupId  Int?       @map("year_group_id")
  date         DateTime   @map("date")
  startTime    String     @map("start_time")
  endTime      String     @map("end_time")
  label        String?    @map("label")
  order        Int        @default(0)
  matches      Match[]
  yearGroup    YearGroup? @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([yearGroupId])
  @@map("time_slots")
}

model Field {
  id           Int        @id @default(autoincrement())
  tournamentId Int        @map("tournament_id")
  yearGroupId  Int?       @map("year_group_id")
  name         String     @default("Feld 1")
  status       String     @default("verfügbar") @map("status")
  yearGroup    YearGroup? @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]

  @@index([tournamentId])
  @@index([yearGroupId])
  @@map("fields")
}

model KnockoutBracket {
  id           Int        @id @default(autoincrement())
  tournamentId Int        @map("tournament_id")
  yearGroupId  Int?       @map("year_group_id")
  name         String
  runde        String
  order        Int        @default(0)
  yearGroup    YearGroup? @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]    @relation("KnockoutMatches")

  @@index([tournamentId])
  @@index([yearGroupId])
  @@map("knockout_brackets")
}

model StandingsEntry {
  id           Int        @id @default(autoincrement())
  teamId       Int        @unique @map("team_id")
  tournamentId Int        @map("tournament_id")
  played       Int        @default(0) @map("played")
  won          Int        @default(0) @map("won")
  drawn        Int        @default(0) @map("drawn")
  lost         Int        @default(0) @map("lost")
  goalsFor     Int        @default(0) @map("goals_for")
  goalsAgainst Int        @default(0) @map("goals_against")
  points       Int        @default(0) @map("points")
  position     Int        @default(0) @map("position")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation("teamStandings", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, tournamentId])
  @@index([tournamentId])
  @@map("standings_entries")
}

model TournamentClub {
  id           Int        @id @default(autoincrement())
  tournamentId Int        @map("tournament_id")
  clubId       Int        @map("club_id")
  club         Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, clubId])
  @@index([clubId])
  @@map("tournament_clubs")
}
