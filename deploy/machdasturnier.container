# Beispiel Podman Quadlet Unit für "Mach das Turnier!" (machdasturnier).
#
# Installation auf dem Server (rootless Podman, empfohlen):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/machdasturnier.container ~/.config/containers/systemd/
#   mkdir -p ~/.config/machdasturnier
#   cp deploy/machdasturnier.env.example ~/.config/machdasturnier/machdasturnier.env
#   # machdasturnier.env jetzt mit echten Werten füllen (siehe Kommentare darin)
#   systemctl --user daemon-reload
#   systemctl --user start machdasturnier.service
#   systemctl --user status machdasturnier.service
#   journalctl --user -u machdasturnier.service -f
#
# Für System-weiten (root) Betrieb stattdessen nach /etc/containers/systemd/
# kopieren und "--user" bei den systemctl-Aufrufen weglassen; den Pfad in
# EnvironmentFile= unten entsprechend anpassen (z.B. /etc/machdasturnier/machdasturnier.env).
#
# WICHTIG: Secrets gehören NICHT in diese Datei (sie kann committet/geteilt
# werden), sondern ausschließlich in die separate machdasturnier.env
# (EnvironmentFile=, siehe unten) - die NIE ins Git-Repo gehört.

[Unit]
Description=Mach das Turnier! (machdasturnier)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/peterphilipp/machdasturnier:latest
# Zieht bei "podman auto-update" automatisch das neueste :latest-Image,
# sobald ein neuer Versions-Tag (v*) released und gepusht wurde.
AutoUpdate=registry
PublishPort=5000:5000

# Persistente SQLite-Datenbank - muss zu DATABASE_URL in machdasturnier.env passen.
Volume=machdasturnier-data:/app/prisma/data

# Alle Umgebungsvariablen kommen aus einer separaten Datei, NICHT als einzelne
# "Environment=..."-Zeilen hier: eine EnvironmentFile wird zeilenweise als
# KEY=VALUE gelesen, OHNE das Leerzeichen-Word-Splitting, das eine einzelne
# "Environment=KEY=VALUE mit Leerzeichen"-Zeile in Unit-Dateien betrifft (das
# war die Ursache eines früheren Bugs: FRONTEND_URL/EMAIL_FROM wurden am
# ersten Leerzeichen abgeschnitten). Pfad ggf. anpassen, siehe Installations-
# Hinweis oben.
EnvironmentFile=%h/.config/machdasturnier/machdasturnier.env

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
