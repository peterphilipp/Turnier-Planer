# Beispiel-Umgebungsdatei für den Produktionsbetrieb (Podman Quadlet, siehe
# turnier-planer.container in diesem Ordner) oder docker-compose.yml.
#
# Kopieren nach z.B. /etc/turnier-planer/turnier-planer.env und mit echten
# Werten füllen. Diese Datei NIE mit echten Secrets committen.
#
# WICHTIG zur Syntax: Das ist eine EnvironmentFile im systemd-Sinn - anders
# als eine einzelne "Environment=..."-Zeile in einer .container/.service-Unit
# wird der Wert HIER NICHT am Leerzeichen aufgesplittet. Werte mit Leerzeichen
# (z.B. EMAIL_FROM weiter unten) brauchen deshalb KEINE Anführungszeichen.
# Genau das war die Ursache eines früheren Bugs: FRONTEND_URL/EMAIL_FROM waren
# direkt (unquotiert) als "Environment=..." in der Unit gesetzt, wodurch
# systemd den Wert am ersten Leerzeichen abschnitt.

# === Pflicht ===
# JWT-Secret zum Signieren/Verifizieren der Tokens.
# MUSS gesetzt sein (mind. 16 Zeichen) - der Server startet sonst NICHT.
# Sicheres Secret erzeugen z.B. mit: openssl rand -hex 32
JWT_SECRET=bitte-durch-ein-langes-zufaelliges-secret-ersetzen

# Basis-URL, unter der das Frontend erreichbar ist (für Passwort-Reset-Links
# in E-Mails/Push). Fehlt diese Variable, fällt der Server auf den
# Dev-Fallback http://localhost:5173 zurück - Reset-Links wären dann kaputt.
FRONTEND_URL=https://turnier-planer.mygate.dedyn.io

# === Optional ===
# Prisma/SQLite Datenbank. Relativer Pfad innerhalb des Containers (WORKDIR
# /app) - muss zum Volume-Mount in turnier-planer.container passen.
DATABASE_URL=file:./prisma/data/dev.db

# E-Mail-Versand über Resend (Passwort-Reset). Ohne RESEND_API_KEY wird der
# Versand übersprungen (kein Fehler, nur ein Log-Eintrag).
# WICHTIG: Nur die hier eingetragene Absenderadresse ist bei Resend verifiziert -
# die eigentliche App-Domain (turnier-planer.mygate.dedyn.io) ist es NICHT,
# Versand mit einer anderen Absenderadresse schlägt mit einem 422-Fehler fehl.
RESEND_API_KEY=
EMAIL_FROM=Macht das Turnier! <noreply@mygate.dedyn.io>

# Kommagetrennte E-Mails, die beim Login/Registrieren automatisch ADMIN werden
ADMIN_EMAILS=admin@example.com

# === Web-Push (VAPID) ===
# Beide Schlüssel gemeinsam generieren mit: npx web-push generate-vapid-keys
# Ohne beide Werte bleibt Web-Push deaktiviert (kein Fehler, nur eine Warnung).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:noreply@mygate.dedyn.io
